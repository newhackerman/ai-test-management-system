{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 1,
    "reload": true,
    "debug": false,
    "log_level": "INFO"
  },
  "performance": {
    "max_request_size": 104857600,
    "timeout": 30,
    "keepalive_timeout": 5,
    "max_concurrent_requests": 1000
  },
  "security": {
    "allowed_hosts": ["*"],
    "trusted_hosts": ["localhost", "127.0.0.1"],
    "enable_https_redirect": false,
    "enable_hsts": false
  }
}